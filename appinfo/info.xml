<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">

    <id>nc_vertragswerk</id>
    <name>VertragsWerk</name>
    <summary>Vertragsverwaltung mit Kündigungserinnerungen</summary>
    <description><![CDATA[
# VertragsWerk

Verwalten Sie Ihre Verträge zentral in Nextcloud:

- **Vertragsübersicht** mit allen wichtigen Daten und Restzeit bis zur Frist
- **Seitenleiste** mit Details, Laufzeit und Dokumenten des Vertrags
- **Automatische Erinnerungen** vor Kündigungsfristen
- **Kategorien und Vertragsarten** zur Organisation
- **Kontakte** aus dem Adressbuch verknüpfen oder neu anlegen
- **Vertragsspiegel** als PDF
- **Archiv** für beendete Verträge
- **Dateianhänge** aus Nextcloud Files

Behalten Sie den Überblick über Laufzeiten, Kosten und Kündigungsfristen.
    ]]></description>

    <version>2.0.1</version>
    <licence>AGPL-3.0-or-later</licence>

    <author mail="felix@schepmann.de" homepage="https://github.com/fds2610/contractmanager">fds2610</author>
    <author mail="axel.deffner@cpcmomentum.com" homepage="https://github.com/cpcMomentum">Axel Deffner</author>

    <namespace>NcVertragswerk</namespace>

    <category>organization</category>
    <category>office</category>

    <bugs>https://github.com/fds2610/contractmanager/issues</bugs>
    <repository type="git">https://github.com/fds2610/contractmanager.git</repository>

    <screenshot>https://raw.githubusercontent.com/fds2610/contractmanager/develop/screenshots/screenshot-contract-list.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/fds2610/contractmanager/develop/screenshots/screenshot-contract-filter.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/fds2610/contractmanager/develop/screenshots/screenshot-contract-form.png</screenshot>
    <screenshot>https://raw.githubusercontent.com/fds2610/contractmanager/develop/screenshots/screenshot-settings.png</screenshot>

    <dependencies>
        <nextcloud min-version="33" max-version="35"/>
        <php min-version="8.2"/>
    </dependencies>

    <background-jobs>
        <job>OCA\NcVertragswerk\BackgroundJob\ReminderJob</job>
        <job>OCA\NcVertragswerk\BackgroundJob\TrashCleanupJob</job>
        <job>OCA\NcVertragswerk\BackgroundJob\StatusUpdateJob</job>
        <job>OCA\NcVertragswerk\BackgroundJob\AutoBackupJob</job>
    </background-jobs>

    <commands>
        <command>OCA\NcVertragswerk\Command\ExportContracts</command>
        <command>OCA\NcVertragswerk\Command\ImportContracts</command>
    </commands>

    <repair-steps>
        <post-migration>
            <step>OCA\NcVertragswerk\Migration\CleanupExtraFiles</step>
            <step>OCA\NcVertragswerk\Migration\WhatsNewBootstrap</step>
            <step>OCA\NcVertragswerk\Migration\SeedAreas</step>
        </post-migration>
        <install>
            <step>OCA\NcVertragswerk\Migration\ImportFromContractManager</step>
            <step>OCA\NcVertragswerk\Migration\SeedAreas</step>
        </install>
    </repair-steps>

    <navigations>
